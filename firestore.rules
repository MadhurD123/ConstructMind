rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // User Profiles verification
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && (data.keys().size() == 3 || (data.keys().size() == 4 && data.displayName is string && data.displayName.size() <= 256))
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.createdAt == request.time;
    }

    // Project metadata verification
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'summary', 'uploadedAt', 'ownerId'])
        && data.keys().size() == 5
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 512
        && data.summary is map
        && data.uploadedAt == request.time
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && incoming().ownerId == request.auth.uid && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid && incoming().ownerId == request.auth.uid && isValidProject(incoming()) && incoming().id == existing().id && incoming().uploadedAt == existing().uploadedAt;
      allow delete: if isSignedIn() && isValidId(projectId) && (!('ownerId' in existing()) || existing().ownerId == request.auth.uid);
    }
  }
}
