{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile credentials and registration details",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID from Firebase Auth"
        },
        "email": {
          "type": "string",
          "description": "Email address of the user"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user document was created"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "BIM model analysis project details and summary mapping",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the project"
        },
        "name": {
          "type": "string",
          "description": "Original IFC file name"
        },
        "summary": {
          "type": "object",
          "description": "Parsed statistics and structures of the BIM model"
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the project was created"
        },
        "ownerId": {
          "type": "string",
          "description": "ID of the user who uploaded the project"
        }
      },
      "required": ["id", "name", "summary", "uploadedAt", "ownerId"]
    },
    "EnergyAnalysis": {
      "title": "EnergyAnalysis",
      "description": "AI-generated sustainability and energy efficiency analysis results",
      "type": "object",
      "properties": {
        "energyScore": {
          "type": "integer",
          "description": "Insulation and structural sustainability score"
        },
        "sustainabilityRating": {
          "type": "string",
          "description": "Literal rating based on score: Poor, Average, Good, Excellent"
        },
        "annualEnergyConsumption": {
          "type": "number",
          "description": "Calculated annual energy consumption in kWh"
        },
        "carbonFootprint": {
          "type": "number",
          "description": "Estimated carbon emissions footprint in metric tons"
        },
        "coolingLoadEstimate": {
          "type": "number",
          "description": "Estimated peak cooling requirements in kW"
        },
        "heatingLoadEstimate": {
          "type": "number",
          "description": "Estimated peak heating requirements in kW"
        },
        "naturalLightingScore": {
          "type": "integer",
          "description": "Aesthetic natural day lighting factor from 0 to 100"
        },
        "sustainabilitySummary": {
          "type": "string",
          "description": "Concise green-building AI executive summary"
        },
        "recommendations": {
          "type": "array",
          "description": "List of structural and design energy efficiency improvements"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when report was completed"
        },
        "projectId": {
          "type": "string",
          "description": "ID of the associated project"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner of the parent project"
        }
      },
      "required": [
        "energyScore",
        "sustainabilityRating",
        "annualEnergyConsumption",
        "carbonFootprint",
        "coolingLoadEstimate",
        "heatingLoadEstimate",
        "naturalLightingScore",
        "sustainabilitySummary",
        "recommendations",
        "generatedAt",
        "projectId",
        "ownerId"
      ]
    },
    "Report": {
      "title": "Report",
      "description": "Generated professional AI technical report metadata",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "description": "Unique identifier of the generated report"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when report was generated"
        },
        "reportUrl": {
          "type": "string",
          "description": "Download and print endpoint URL"
        },
        "reportSize": {
          "type": "number",
          "description": "Size of PDF document in bytes"
        },
        "reportStatus": {
          "type": "string",
          "description": "Completion state of the document"
        },
        "projectId": {
          "type": "string",
          "description": "ID of the associated project"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner of the parent project"
        }
      },
      "required": ["reportId", "generatedAt", "reportUrl", "reportSize", "reportStatus", "projectId", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User credential documents"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project documents containing IFC metadata and summary analysis"
    },
    "/projects/{projectId}/energyAnalysis/{analysisId}": {
      "schema": "EnergyAnalysis",
      "description": "AI-generated energy performance ratings"
    },
    "/projects/{projectId}/reports/{reportId}": {
      "schema": "Report",
      "description": "AI generated complete executive report list"
    }
  }
}
